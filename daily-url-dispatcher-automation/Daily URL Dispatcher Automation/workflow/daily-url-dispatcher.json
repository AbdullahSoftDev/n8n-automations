      "id": "540b0085-0da0-437a-bdcd-ae14f4ac9b35",
      "name": "Get All Rows",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        224,
        300
      ],
      "credentials": {}
    },
    {
      "parameters": {
        "jsCode": "// Keep only rows where Status is empty, then take the first one\nconst rows = $input.all().filter(item => {\n  const status = String(item.json.Status || '').trim().toLowerCase();\n  const url = String(item.json.URL || '').trim();\n  return url !== '' && (status === '' || status === 'empty');\n});\n\nif (rows.length === 0) {\n  return [];\n}\n\nreturn [rows[0]];"
      },
      "id": "96082801-58a0-4f3a-8301-24e38bb122a0",
      "name": "Pick Unsent URL",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        300
      ]
    },
    {
      "parameters": {
        "command": "=timeout 900 yt-dlp --no-progress --socket-timeout 30 --js-runtimes node --remote-components ejs:github -x --audio-format mp3 --audio-quality 0 --no-playlist --force-overwrites -o \"/home/node/.n8n-files/song.%(ext)s\" \"{{ $('Pick Unsent URL').item.json.URL }}\""
      },
      "id": "a1b2c3d4-6666-4a66-8a66-000000000006",
      "name": "YouTube to MP3 (yt-dlp)",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        700,
        450
      ],
      "executeOnce": true
    },
    {
      "parameters": {
        "fileSelector": "/home/node/.n8n-files/song.mp3",
        "options": {
          "dataPropertyName": "audio"
        }
      },
      "id": "a1b2c3d4-7777-4a77-8a77-000000000007",
      "name": "Read MP3 File",
      "type": "n8n-nodes-base.readWriteFile",
      "typeVersion": 1,
      "position": [
        924,
        450
      ]
    },
    {
      "parameters": {
        "jsCode": "// Name the attachment after the song title\nconst title = $('Pick Unsent URL').first().json.Title || 'song';\nconst safe = String(title).replace(/[\\\\/:*?\"<>|]/g, '').trim() || 'song';\n\nconst items = $input.all();\nfor (const item of items) {\n  item.binary.audio.fileName = safe + '.mp3';\n  item.binary.audio.mimeType = 'audio/mpeg';\n}\nreturn items;"
      },
      "id": "a1b2c3d4-8888-4a88-8a88-000000000008",
      "name": "Name MP3",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1148,
        450
      ]
    },
    {
      "parameters": {
        "mode": "combine",
        "combineBy": "combineByPosition",
        "options": {}
      },
      "id": "a1b2c3d4-9999-4a99-8a99-000000000009",
      "name": "Wait for Both Uploads",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3,
      "position": [
        1596,
        300
      ]
    },
    {
      "parameters": {
        "sendTo": "YOUR_EMAIL@example.com",
        "subject": "=✅ Files ready: {{ $('Pick Unsent URL').item.json.Title }}",
        "emailType": "text",
        "message": "=Hi,\n\nYour files are ready in Google Drive.\n\nSong: {{ $('Pick Unsent URL').item.json.Title }}\nYouTube: {{ $('Pick Unsent URL').item.json.URL }}\n\nMP3: https://drive.google.com/file/d/{{ $('Upload MP3 to Drive').item.json.id }}/view\nCover image: https://drive.google.com/file/d/{{ $('Upload Cover to Drive').item.json.id }}/view\n\n— Your n8n automation",
        "options": {}
      },
      "id": "0b7f8eb6-b039-460f-8c71-b34065932050",
