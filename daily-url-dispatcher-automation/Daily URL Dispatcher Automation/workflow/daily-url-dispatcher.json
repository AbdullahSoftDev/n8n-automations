      "id": "c1c2c3c4-1111-4a11-8a11-000000000101",
      "name": "Generate Image (Cloudflare)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        700,
        150
      ]
    },
    {
      "parameters": {
        "jsCode": "// Turn Cloudflare's base64 image into an n8n binary file called 'image'\nconst out = [];\nfor (const item of $input.all()) {\n  let b64 = (item.json && item.json.result && item.json.result.image) || (item.json && item.json.image);\n  if (b64) {\n    b64 = b64.replace(/^data:image\\/\\w+;base64,/, '');\n    const buf = Buffer.from(b64, 'base64');\n    const isPng = buf[0] === 0x89 && buf[1] === 0x50;\n    const bin = await this.helpers.prepareBinaryData(\n      buf,\n      isPng ? 'cover.png' : 'cover.jpg',\n      isPng ? 'image/png' : 'image/jpeg'\n    );\n    out.push({ json: {}, binary: { image: bin } });\n  } else if (item.binary && item.binary.data) {\n    out.push({ json: {}, binary: { image: item.binary.data } });\n  } else {\n    throw new Error('No image in Cloudflare response: ' + JSON.stringify(item.json).slice(0, 300));\n  }\n}\nreturn out;"
      },
      "id": "c1c2c3c4-2222-4a22-8a22-000000000102",
